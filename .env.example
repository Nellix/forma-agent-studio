PORT=3000
HOST=127.0.0.1
DATABASE_URL=pglite://.data/studio
DEMO_MODE=true
EMBEDDED_WORKER=true
# Generate values with npm run secrets. Required for shared/production deployments.
STUDIO_ADMIN_TOKEN=
STUDIO_RUNNER_TOKEN=
ENCRYPTION_KEY=
COOKIE_SECURE=false
# Exact comma-separated hosts permitted for HTTP Request workflow nodes.
HTTP_ALLOWED_HOSTS=
MAX_CONCURRENT_RUNS=4
# Optional custom CA, loaded by Node before startup:
# NODE_EXTRA_CA_CERTS=/certificates/internal-ca.pem
